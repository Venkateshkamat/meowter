{
  "name": "meowter-cats",
  "displayName": "Meowter",
  "description": "Pixel-art cats take over your editor when it's time for a break.",
  "version": "1.0.1",
  "publisher": "venkateshkamat",
  "author": "Venkatesh Kamat",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Venkateshkamat/meowter.git"
  },
  "homepage": "https://github.com/Venkateshkamat/meowter#readme",
  "bugs": {
    "url": "https://github.com/Venkateshkamat/meowter/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "break",
    "break reminder",
    "pomodoro",
    "rest",
    "cats",
    "cat",
    "pets",
    "pixel art",
    "wellbeing",
    "productivity",
    "timer",
    "eye strain",
    "stretch",
    "health",
    "reminder",
    "fun",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#ffd591",
    "theme": "light"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/*.js",
    "out/webview/cats.js",
    "media/cats.css",
    "media/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./ && tsc -p ./tsconfig.webview.json && node scripts/bundle-webview.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "pretest:vscode": "npm run compile",
    "pretest:cursor": "npm run compile",
    "test": "npm run test:unit && npm run test:vscode",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "test:vscode": "node ./out/test/runTest.js vscode",
    "test:cursor": "node ./out/test/runTest.js cursor"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "gifenc": "^1.0.3",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "configuration": {
      "title": "Meowter",
      "properties": {
        "meowter.breakIntervalMinutes": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Minutes of active IDE use before a break."
        },
        "meowter.idleThresholdMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Minutes without input after which time stops counting."
        },
        "meowter.catCount": {
          "type": "integer",
          "default": 6,
          "minimum": 2,
          "maximum": 30,
          "description": "Number of cats shown during a break (a fighting pair counts as two)."
        },
        "meowter.styles": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "wanderer": true,
            "climber": true,
            "bouncer": true,
            "yarnChaser": true,
            "fighters": true
          },
          "properties": {
            "wanderer": {
              "type": "boolean",
              "default": true,
              "description": "Walks, runs, sits, sleeps, swipes and hops on the floor."
            },
            "climber": {
              "type": "boolean",
              "default": true,
              "description": "Climbs the side walls, hangs and grabs, then comes down."
            },
            "bouncer": {
              "type": "boolean",
              "default": true,
              "description": "Bounces in big arcs across the middle of the screen."
            },
            "yarnChaser": {
              "type": "boolean",
              "default": true,
              "description": "Chases and bats a ball of yarn along the floor."
            },
            "fighters": {
              "type": "boolean",
              "default": true,
              "description": "A pair of cats squares up and brawls in a dust cloud."
            }
          },
          "markdownDescription": "Which movement styles the cats use. The cats of a break are dealt out to the enabled styles in turn (Wanderer, Climber, Bouncer, Yarn chaser, Fighters), so with few cats each style gets one first. Fighters always take two cats at a time (a pair fights). If every style is switched off, all cats are Wanderers."
        }
      }
    },
    "commands": [
      {
        "command": "meowter.setBreakInterval",
        "title": "Meowter: Set Break Interval"
      }
    ]
  }
}
